{
  "name": "@monosip/api",
  "version": "1.9.7",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset-admin": "sh scripts/reset-admin-password.sh",
    "db:rotate-key": "tsx src/db/rotate-encryption-key.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --exclude '**/*.int.test.ts' --coverage --coverage.provider=v8 --coverage.include='src/**'",
    "test:coverage:integration": "vitest run --config vitest.integration.config.ts --coverage --coverage.provider=v8 --coverage.include='src/**'"
  },
  "dependencies": {
    "@monosip/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^11.0.0",
    "@fastify/websocket": "^11.2.0",
    "acme-client": "^5.4.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.1",
    "otplib": "^12.0.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.6.2",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
