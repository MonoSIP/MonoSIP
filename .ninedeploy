version: "1"

runtime:
  type: node
  version: "24"

# Monorepo: Docker build context MUST be the repository root.
build:
  dockerfile: "apps/api/Dockerfile"

run:
  port: 3000
  healthcheck: "/api/v1/health"
  restart: unless-stopped

# Persist DB (embedded) + Asterisk config + uploads + secrets across redeploys.
volume:
  mount: "/data"
  backups:
    schedule: "0 3 * * *"
    retention: 14

resources:
  # Embedded Postgres + Asterisk + Node + ffmpeg
  memMb: 2560
  cpuShares: 1024

env:
  aliases:
    POSTGRES_URL: DATABASE_URL
    POSTGRES_PRIVATE_URL: DATABASE_URL

watch:
  paths:
    - "apps/api/**"
    - "apps/web/**"
    - "packages/shared/**"
    - "docker/asterisk/**"
    - "package.json"
    - "pnpm-workspace.yaml"
    - "pnpm-lock.yaml"
    - "apps/api/Dockerfile"
