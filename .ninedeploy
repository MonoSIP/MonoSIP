version: "1"

runtime:
  type: node
  version: "24"

# Monorepo: Docker build context MUST be the repository root.
build:
  dockerfile: "Dockerfile"

run:
  port: 3000
  healthcheck: "/api/v1/health"
  restart: unless-stopped

# Persist DB (embedded) + Asterisk config + uploads + secrets across redeploys.
#
# REQUIRED (NineDeploy UI — this YAML alone does NOT attach storage):
#   Service → Volumes / Persistent disk → Mount path = /data
#   (creates volume nd-svc-<slug>-data). Without that, every Deploy wipes
#   Postgres/settings/trunks because /data lives on the container overlay.
# Or set DATABASE_URL to managed Postgres.
# Optional vault: MUNASIP_REQUIRE_PERSISTENT_DATA=1 — also auto-fatal when
# PUBLIC_HOST is set and /data is not a mount (see bootstrap-runtime.sh).
volume:
  mount: "/data"
  backups:
    schedule: "0 3 * * *"
    retention: 14

# Softphone audio (WebRTC RTP) — publish these in the NineDeploy UI if the
# platform does not map them from this file:
#   UDP 10000-10100 → container 10000-10100
# Then set vault env MUNASIP_RTP_PUBLISHED=1 (and EXTERNAL_IP). Deploy logs +
# /api/v1/health.media warn until that is done.

resources:
  # Embedded Postgres + Asterisk + Node + ffmpeg
  memMb: 2560
  cpuShares: 1024

env:
  aliases:
    POSTGRES_URL: DATABASE_URL
    POSTGRES_PRIVATE_URL: DATABASE_URL

watch:
  paths:
    - "apps/api/**"
    - "apps/web/**"
    - "packages/shared/**"
    - "docker/asterisk/**"
    - "package.json"
    - "pnpm-workspace.yaml"
    - "pnpm-lock.yaml"
    - "Dockerfile"
