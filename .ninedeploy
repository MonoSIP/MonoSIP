version: "1"

runtime:
  type: node
  version: "24"

# Monorepo: Docker build context MUST be the repository root so
# packages/shared and pnpm-workspace.yaml are available.
# Do not set baseDir to apps/api — that produces:
#   docker build -f apps/api/Dockerfile apps/api
# which fails COPY of monorepo paths.
build:
  dockerfile: "apps/api/Dockerfile"

run:
  port: 3000
  healthcheck: "/api/v1/health"
  restart: unless-stopped

watch:
  paths:
    - "apps/api/**"
    - "packages/shared/**"
    - "package.json"
    - "pnpm-workspace.yaml"
    - "pnpm-lock.yaml"
    - "apps/api/Dockerfile"

env:
  required:
    - DATABASE_URL
    - SESSION_SECRET
    - ENCRYPTION_KEY
